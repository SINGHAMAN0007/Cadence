rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for User Profile metadata
    function isValidUserProfile(data) {
      return data.userId is string &&
        data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('favoriteTrackKeys' in data) || (data.favoriteTrackKeys is list && data.favoriteTrackKeys.size() <= 500)) &&
        (!('playlistMetadata' in data) || (data.playlistMetadata is list && data.playlistMetadata.size() <= 200));
    }

    // Validation for Listen Together Playback Session
    function isValidSession(data) {
      return data.id is string &&
        data.id.size() <= 64 &&
        data.roomCode is string &&
        data.roomCode.size() <= 12 &&
        data.hostUserId is string &&
        data.hostUserId.size() <= 128 &&
        data.isPlaying is bool &&
        data.timestamp is number &&
        data.status is string &&
        (data.status == 'active' || data.status == 'ended') &&
        (!('hostDisplayName' in data) || (data.hostDisplayName is string && data.hostDisplayName.size() <= 100)) &&
        (!('trackTitle' in data) || (data.trackTitle is string && data.trackTitle.size() <= 200)) &&
        (!('trackArtist' in data) || (data.trackArtist is string && data.trackArtist.size() <= 200)) &&
        (!('trackAlbum' in data) || (data.trackAlbum is string && data.trackAlbum.size() <= 200)) &&
        (!('trackDuration' in data) || data.trackDuration is number) &&
        (!('lastUpdated' in data) || data.lastUpdated is number) &&
        (!('updatedByDeviceId' in data) || (data.updatedByDeviceId is string && data.updatedByDeviceId.size() <= 64));
    }

    // User metadata & favorites storage
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);
    }

    // Shared "Listen Together" sessions
    match /sessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sessionId) && incoming().hostUserId == request.auth.uid && isValidSession(incoming());
      allow update: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming()) &&
        incoming().hostUserId == existing().hostUserId &&
        incoming().id == existing().id &&
        incoming().roomCode == existing().roomCode &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isPlaying', 'timestamp', 'lastUpdated', 'updatedByDeviceId',
          'trackTitle', 'trackArtist', 'trackAlbum', 'trackDuration', 'status'
        ]);
      allow delete: if isSignedIn() && existing().hostUserId == request.auth.uid;
    }
  }
}
